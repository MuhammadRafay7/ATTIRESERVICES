# Enquiry form email delivery
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in ONE provider. Without it the form
# returns a clear "delivery not configured" error rather than silently
# discarding enquiries.

# Where enquiries are delivered. Required.
CONTACT_TO_EMAIL=mrtrades2005@gmail.com


# --- Option A: Resend (recommended) ------------------------------------------
# 1. Sign up at https://resend.com using mrtrades2005@gmail.com
# 2. Create an API key and paste it below
#
# On the free tier without a verified domain, Resend only delivers to the
# address the account was registered with — which is exactly what we want here.
# Leave CONTACT_FROM_EMAIL unset until a domain is verified.
RESEND_API_KEY=
# CONTACT_FROM_EMAIL=enquiries@yourdomain.com


# --- Option B: Web3Forms (no domain setup at all) -----------------------------
# 1. Enter mrtrades2005@gmail.com at https://web3forms.com
# 2. They email you an access key; paste it below and clear RESEND_API_KEY
WEB3FORMS_ACCESS_KEY=
